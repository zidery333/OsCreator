# Zenith — what shouldn't be committed

# rebuilt automatically by `./os index`
.os/registry.json
.os/cache/

# fetched again on demand, and bigger than everything else here
.os/transcripts/

# local insurance, not source
.os/backups/

# transient
.os/.lock
.os/.dirty
*.tmp~
__pycache__/
*.pyc
.DS_Store
.localized

# rebuilt automatically, so it is never worth a commit
INDEX.md
