{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./os:*)",
      "Bash(${CLAUDE_PROJECT_DIR}/os:*)",
      "Read(${CLAUDE_PROJECT_DIR}/**)",
      "Edit(${CLAUDE_PROJECT_DIR}/**)",
      "Write(${CLAUDE_PROJECT_DIR}/**)"
    ],
    "deny": [
      "Read(${CLAUDE_PROJECT_DIR}/.os/backups/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh",
            "timeout": 15,
            "statusMessage": "Looking at the folder…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/mark-dirty.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/settle.sh",
            "timeout": 60,
            "async": true,
            "statusMessage": "Filing what changed…"
          }
        ]
      }
    ]
  }
}
